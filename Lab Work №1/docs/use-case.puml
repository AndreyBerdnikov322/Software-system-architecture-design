@startuml use-case
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam usecase {
  BackgroundColor #F7F9FC
  BorderColor #4A6FA5
}
skinparam actor {
  BackgroundColor #E8EEF7
  BorderColor #4A6FA5
}

actor "Пользователь" as USER
actor "Администратор" as ADMIN

rectangle "Автономный агент ML-экспериментов (MLP)" {
  usecase "UC-01 [FR-01, FR-02]\nОтправить задание\nна обучение" as UC01 #D6E6F7
  usecase "UC-02 [FR-06, FR-24]\nМониторить ход\nэксперимента" as UC02 #D6E6F7
  usecase "UC-03 [FR-07, FR-20, FR-21]\nОстановить / повторить /\nвозобновить эксперимент" as UC03 #D6E6F7
  usecase "UC-04 [FR-09]\nКлонировать / редактировать\nконфигурацию" as UC04 #D6E6F7
  usecase "UC-05 [FR-17]\nПодобрать гиперпараметры" as UC05 #D6E6F7
  usecase "UC-08 [FR-11]\nПолучать уведомления" as UC08 #D6E6F7
  usecase "UC-10 [FR-14, FR-23]\nРаботать через API/SDK" as UC10 #D6E6F7
  usecase "UC-11 [FR-19, FR-25]\nРазвернуть и настроить\nсистему" as UC11 #FCE0B6
  usecase "UC-12 [FR-12, FR-22]\nУправлять доступом\nи аудитом" as UC12 #FCE0B6
  usecase "UC-13 [FR-13]\nПодтверждать\nкритические действия" as UC13 #D6E6F7
  usecase "UC-07 [FR-18]\nЭкспортировать отчёт" as UC07 #D6E6F7
  usecase "UC-14 [FR-03]\nСпланировать эксперимент" as UC14 #E6E6E6
  usecase "UC-06 [FR-08]\nПолучить отчёт\nи артефакты" as UC06 #D6E6F7
  usecase "UC-15 [FR-04]\nВыполнить навык\n(данные / обучение / тест)" as UC15 #E6E6E6
  usecase "UC-16 [FR-05]\nЗапустить в изолированном\nокружении" as UC16 #E6E6E6
  usecase "UC-09 [FR-15]\nИспользовать RAG-подсказки" as UC09 #E6E6E6
  usecase "UC-18 [FR-16]\nИспользовать кэш\nповторяющихся операций" as UC18 #E6E6E6
  usecase "UC-17 [FR-10]\nВерсионировать артефакты" as UC17 #E6E6E6
}

USER --> UC01
USER --> UC02
USER --> UC03
USER --> UC04
USER --> UC05
USER --> UC06
USER --> UC07
USER --> UC08
USER --> UC10
USER --> UC13
ADMIN --> UC08
ADMIN --> UC11
ADMIN --> UC12

UC01 ..> UC14 : <<include>>
UC14 ..> UC15 : <<include>>
UC15 ..> UC16 : <<include>>
UC15 ..> UC18 : <<include>>
UC15 ..> UC17 : <<include>>
UC06 ..> UC17 : <<include>>
UC07 ..> UC06 : <<include>>
UC09 ..> UC15 : <<extend>>
UC13 ..> UC14 : <<extend>>
UC13 ..> UC16 : <<extend>>

@enduml